# ---------------------------------------------------------------
# TaskFlow API: environment variables template
# Copy this file to .env and fill in real values:
#     cp .env.example .env
# NEVER commit .env. Only this example file belongs in Git.
# ---------------------------------------------------------------

# --- Application (Sprint 1) ---
APP_NAME=TaskFlow API
ENVIRONMENT=development
DEBUG=true

# --- Database (Sprint 2) ---
DATABASE_URL=postgresql+psycopg://taskflow_user:change-me@localhost:5432/taskflow

# --- Authentication (Sprint 4) ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
